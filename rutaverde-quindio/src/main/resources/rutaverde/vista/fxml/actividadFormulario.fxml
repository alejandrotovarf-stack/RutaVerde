<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="formulario" spacing="10"
      styleClass="panel-vidrio" prefWidth="520" fx:controller="rutaverde.controlador.ActividadFormularioControlador">
    <padding><Insets top="26" right="28" bottom="26" left="28"/></padding>
    <Label text="Nueva actividad" styleClass="titulo-seccion"/>
    <Label text="Los campos con * son obligatorios." styleClass="texto-suave"/>
    <TextField fx:id="campoNombre" promptText="Nombre *"/>
    <TextField fx:id="campoMunicipio" promptText="Municipio *"/>
    <TextArea fx:id="areaDescripcion" promptText="Descripción (opcional)" prefRowCount="3" wrapText="true"/>
    <HBox spacing="10">
        <TextField fx:id="campoPrecio" promptText="Precio por persona (COP) *" HBox.hgrow="ALWAYS"/>
        <TextField fx:id="campoDuracion" promptText="Duración (horas) *" HBox.hgrow="ALWAYS"/>
    </HBox>
    <HBox spacing="10">
        <TextField fx:id="campoCupo" promptText="Cupo máximo por día *" HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="comboDificultad" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
    </HBox>
    <CheckBox fx:id="checkDisponible" text="Disponible para reservas" selected="true"/>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button text="Elegir fotografía…" styleClass="boton-secundario" onAction="#elegirImagen"/>
        <Label fx:id="etiquetaImagen" text="Sin imagen: se usará una predeterminada" styleClass="texto-suave"/>
    </HBox>
    <Label fx:id="etiquetaMensaje" styleClass="mensaje" wrapText="true"/>
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancelar" styleClass="boton-secundario" onAction="#cancelar"/>
        <Button text="Guardar actividad" styleClass="boton-primario" onAction="#guardar"/>
    </HBox>
</VBox>
