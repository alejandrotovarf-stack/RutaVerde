<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" spacing="24"
      fx:controller="rutaverde.controlador.PanelControlador">
    <padding><Insets top="32" right="36" bottom="32" left="36"/></padding>
    <VBox styleClass="hero" spacing="6">
        <Label text="Buenos días, asesor" styleClass="titulo"/>
        <Label text="Gestiona reservas del Eje Cafetero sin sobreventas ni cobros mal calculados." styleClass="texto-hero"/>
    </VBox>
    <HBox spacing="20">
        <VBox styleClass="metrica" HBox.hgrow="ALWAYS"><Label text="Reservas confirmadas" styleClass="texto-suave"/><Label fx:id="etiquetaReservas" styleClass="numero"/></VBox>
        <VBox styleClass="metrica" HBox.hgrow="ALWAYS"><Label text="Ingresos confirmados" styleClass="texto-suave"/><Label fx:id="etiquetaIngresos" styleClass="numero"/></VBox>
        <VBox styleClass="metrica" HBox.hgrow="ALWAYS"><Label text="Producto con más viajeros" styleClass="texto-suave"/><Label fx:id="etiquetaProductoTop" styleClass="numero-pequeno"/></VBox>
    </HBox>
</VBox>
